# Wails build artifacts
.task
bin
frontend/dist
frontend/node_modules
build/linux/appimage/build
build/linux/wireguide.desktop
build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
# Per-architecture versioninfo rendered by tools/genverinfo during
# `task generate:syso` (source of truth is versioninfo.json.tmpl).
build/windows/versioninfo.gen.json

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.syso

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Icon build intermediates
build/icon.iconset/
build/icon/wireguide.icns

# Compiled asset catalog — regenerated by `wails3 generate icons` from
# build/appicon.icon. Must NOT be committed: if present in the .app
# bundle, macOS prioritises it over icons.icns via CFBundleIconName,
# which caused persistent icon-cache issues during development.
build/darwin/Assets.car

# Claude Code working files — plans and local settings are per-user, not
# repo state.
.claude/
.spec-mix/

# Helper debugging artifacts (stderr captures from `task build DEV=true`
# launches with WIREGUIDE_HELPER_STDERR=1). Repo-relative, throwaway.
debug-logs/

# CodeBuddy local data — per-user plans, automations and settings; not repo state.
.codebuddy/

# Backup files
*.bak

# Log files
*.log

# Local historical release archive — installers / packages kept on disk
# for rollback & offline distribution. Binaries are intentionally NOT
# tracked (repo bloat); the README is tracked so the directory's purpose
# survives clones. `git clean -fd` never touches this directory (ignored
# files are kept); only an explicit `git clean -fdx` would remove it —
# never run the -x variant casually.
releases/*
!releases/README.md

